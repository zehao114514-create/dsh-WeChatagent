 export function relevantSearchResults(query,items){
   const text=String(query).toLowerCase().replace(/(?:是什么|什么意思|怎么样|如何|多少|今天|明天|最新|现在|一下|帮我)/g,' ');
   const terms=[...(text.match(/[a-z0-9][a-z0-9_-]{1,}/g)??[])];
